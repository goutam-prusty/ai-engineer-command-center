{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Learner profile, onboarding status, current DataMites week, and weekly hour targets.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "learnerName": { "type": "string", "maxLength": 100 },
        "onboardingCompleted": { "type": "boolean" },
        "currentWeek": { "type": "integer" },
        "weeklyLiveHours": { "type": "number" },
        "weeklySelfStudyHours": { "type": "number" },
        "weeklyPracticeHours": { "type": "number" },
        "internshipIntakeDone": { "type": "boolean" },
        "internshipMentoringHours": { "type": "number" },
        "internshipCertificateDone": { "type": "boolean" },
        "internshipExperienceLetterDone": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "learnerName",
        "onboardingCompleted",
        "currentWeek",
        "weeklyLiveHours",
        "weeklySelfStudyHours",
        "weeklyPracticeHours",
        "createdAt",
        "updatedAt"
      ]
    },
    "TopicProgress": {
      "title": "TopicProgress",
      "description": "Official DataMites subtopic progress, assignment/revision status, notes, and evidence link.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "topicId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "week": { "type": "integer" },
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "practised", "demonstrated", "needs_revision", "complete"]
        },
        "assignmentStatus": {
          "type": "string",
          "enum": ["not_started", "in_progress", "submitted", "reviewed"]
        },
        "revisionStatus": {
          "type": "string",
          "enum": ["none", "scheduled", "needs_revision", "revised"]
        },
        "notes": { "type": "string", "maxLength": 4000 },
        "evidenceUrl": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "topicId", "week", "status", "assignmentStatus", "revisionStatus", "notes", "evidenceUrl", "updatedAt"]
    },
    "BonusProgress": {
      "title": "BonusProgress",
      "description": "Isolated progress for optional DataMites Bonus Value-Added Course modules.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "moduleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "complete"]
        },
        "notes": { "type": "string", "maxLength": 2000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "moduleId", "status", "notes", "updatedAt"]
    },
    "ResourceState": {
      "title": "ResourceState",
      "description": "Supplementary lecture watched state (strictly separate from official mastery) and pinned study week.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "resourceId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "watched": { "type": "boolean" },
        "pinnedWeek": { "type": "integer" },
        "note": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "resourceId", "watched", "pinnedWeek", "note", "updatedAt"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "Editable weekly study plan session block.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "week": { "type": "integer" },
        "day": { "type": "string", "enum": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "category": { "type": "string", "enum": ["live_class", "self_study", "practice", "revision", "supplementary"] },
        "plannedMinutes": { "type": "integer" },
        "completed": { "type": "boolean" },
        "linkedRef": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "week", "day", "title", "category", "plannedMinutes", "completed", "linkedRef", "createdAt", "updatedAt"]
    },
    "PracticeLog": {
      "title": "PracticeLog",
      "description": "Completion state and code/notebook evidence for hands-on exercises and coding challenges.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "exerciseId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "week": { "type": "integer" },
        "status": { "type": "string", "enum": ["not_started", "in_progress", "completed"] },
        "evidenceUrl": { "type": "string", "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 3000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "exerciseId", "week", "status", "evidenceUrl", "notes", "updatedAt"]
    },
    "ProjectRecord": {
      "title": "ProjectRecord",
      "description": "Official DataMites projects, internship deliverables, or supplementary personal portfolio projects.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "category": { "type": "string", "enum": ["official_datamites", "internship", "supplementary_personal"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "competencyArea": { "type": "string", "maxLength": 120 },
        "problemStatement": { "type": "string", "maxLength": 2000 },
        "skills": { "type": "array" },
        "datasetSource": { "type": "string", "maxLength": 300 },
        "milestones": { "type": "array" },
        "deliverables": { "type": "string", "maxLength": 1500 },
        "githubUrl": { "type": "string", "maxLength": 500 },
        "completionCriteria": { "type": "string", "maxLength": 1500 },
        "status": { "type": "string", "enum": ["planned", "in_progress", "completed"] },
        "provenance": { "type": "string", "enum": ["DATAMITES_OFFICIAL", "SUPPLEMENTARY_PRACTICE_PROPOSED", "UNVERIFIED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "category",
        "title",
        "competencyArea",
        "problemStatement",
        "skills",
        "datasetSource",
        "milestones",
        "deliverables",
        "githubUrl",
        "completionCriteria",
        "status",
        "provenance",
        "createdAt",
        "updatedAt"
      ]
    },
    "WeakConcept": {
      "title": "WeakConcept",
      "description": "Saved weak concept flagged during study, quizzes, or flashcards.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "week": { "type": "integer" },
        "topicId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "notes": { "type": "string", "maxLength": 2000 },
        "resolved": { "type": "boolean" },
        "source": { "type": "string", "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "week", "topicId", "title", "notes", "resolved", "source", "createdAt", "updatedAt"]
    },
    "FlashcardState": {
      "title": "FlashcardState",
      "description": "Learner familiarity state for each curated flashcard.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "cardId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["unreviewed", "known", "needs_review"] },
        "reviewCount": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "cardId", "status", "reviewCount", "updatedAt"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Immutable log of an offline practice quiz attempt.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "week": { "type": "integer" },
        "score": { "type": "integer" },
        "total": { "type": "integer" },
        "missedTopicIds": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "week", "score", "total", "missedTopicIds", "createdAt"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "Structured 7-field daily engineering learning journal entry.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "minLength": 4, "maxLength": 32 },
        "week": { "type": "integer" },
        "learnedToday": { "type": "string", "maxLength": 3000 },
        "implemented": { "type": "string", "maxLength": 3000 },
        "problemsEncountered": { "type": "string", "maxLength": 3000 },
        "howSolved": { "type": "string", "maxLength": 3000 },
        "unclearConcepts": { "type": "string", "maxLength": 3000 },
        "mentorQuestions": { "type": "string", "maxLength": 3000 },
        "mentorResolved": { "type": "boolean" },
        "nextSession": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "date",
        "week",
        "learnedToday",
        "implemented",
        "problemsEncountered",
        "howSolved",
        "unclearConcepts",
        "mentorQuestions",
        "mentorResolved",
        "nextSession",
        "createdAt",
        "updatedAt"
      ]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Immutable recent learning activity event for Dashboard and Analytics.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["topic", "practice", "quiz", "flashcard", "project", "journal", "resource", "plan"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "detail": { "type": "string", "maxLength": 300 },
        "week": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "type", "title", "detail", "week", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-scoped learner profile and active week settings."
    },
    "/users/{userId}/topicProgress/{topicId}": {
      "schema": { "$ref": "#/entities/TopicProgress" },
      "description": "Official DataMites subtopic progress documents."
    },
    "/users/{userId}/bonusProgress/{moduleId}": {
      "schema": { "$ref": "#/entities/BonusProgress" },
      "description": "Isolated progress for optional DataMites Bonus Courses."
    },
    "/users/{userId}/resourceStates/{resourceId}": {
      "schema": { "$ref": "#/entities/ResourceState" },
      "description": "Supplementary lecture watched state and pinned week."
    },
    "/users/{userId}/studySessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudySession" },
      "description": "Editable daily study plan sessions."
    },
    "/users/{userId}/practiceLogs/{exerciseId}": {
      "schema": { "$ref": "#/entities/PracticeLog" },
      "description": "Hands-on practice and coding exercise completion logs."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/ProjectRecord" },
      "description": "Official DataMites, internship, and supplementary personal projects."
    },
    "/users/{userId}/weakConcepts/{conceptId}": {
      "schema": { "$ref": "#/entities/WeakConcept" },
      "description": "Saved weak concepts flagged for targeted revision."
    },
    "/users/{userId}/flashcardStates/{cardId}": {
      "schema": { "$ref": "#/entities/FlashcardState" },
      "description": "Flashcard mastery states (Known vs Needs Review)."
    },
    "/users/{userId}/quizAttempts/{attemptId}": {
      "schema": { "$ref": "#/entities/QuizAttempt" },
      "description": "Offline practice quiz attempt history."
    },
    "/users/{userId}/journalEntries/{entryId}": {
      "schema": { "$ref": "#/entities/JournalEntry" },
      "description": "Daily structured learning journal entries."
    },
    "/users/{userId}/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Recent learning activity timeline entries."
    }
  }
}
